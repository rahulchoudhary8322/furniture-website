# --- BACKEND ENVIRONMENT CONFIGURATION ---
PORT=5000
NODE_ENV=production

# Database Settings (Local defaults to XAMPP automatically, production must override)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_PORT=3306
DB_NAME=

# Security
JWT_SECRET=

# Notification and Mail Settings (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=

# Dynamic Front-end link for notification emails
FRONTEND_URL=

# Administrative Setup
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- MILLI-AI INTEGRATION (IF USED) ---
OPENROUTER_API_KEY=
SARVAM_API_KEY=

# --- FRONTEND ENVIRONMENT CONFIGURATION ---
# Note: In Vite apps, variables must be prefixed with VITE_ to be exposed to client-side code.
# Do NOT place database passwords or private API keys here.
VITE_API_URL=
